        { "source": "parent_id", "target": "manager_id", "transform": "extract_id" },
        { "source": "user_id", "target": "user_id", "transform": "extract_id" },
        { "source": "active", "target": "active", "transform": "direct" },
        { "source": "create_date", "target": "created_at", "transform": "direct" },
        { "source": "write_date", "target": "updated_at", "transform": "direct" }
      ]
    },
    "invoice": {
      "source_model": "account.move",
      "source_filter": "move_type IN ('out_invoice', 'out_refund')",
      "fields": [
        { "source": "id", "target": "source_record_id", "transform": "to_string" },
        { "source": "name", "target": "invoice_number", "transform": "direct" },
        { "source": "partner_id", "target": "account_id", "transform": "extract_id" },
        { "source": "partner_id", "target": "account_name", "transform": "extract_name" },
        { "source": "invoice_date", "target": "invoice_date", "transform": "direct" },
        { "source": "invoice_date_due", "target": "due_date", "transform": "direct" },
        { "source": "amount_untaxed", "target": "amount_untaxed", "transform": "direct" },
        { "source": "amount_tax", "target": "amount_tax", "transform": "direct" },
        { "source": "amount_total", "target": "amount_total", "transform": "direct" },
        { "source": "currency_id", "target": "currency", "transform": "extract_name" },
        { "source": "state", "target": "state", "transform": "direct" },
        { "source": "payment_state", "target": "payment_state", "transform": "direct" },
        { "source": "create_date", "target": "created_at", "transform": "direct" },
        { "source": "write_date", "target": "updated_at", "transform": "direct" }
      ]
    },
    "activity": {
      "source_model": "mail.activity",
      "source_filter": "res_model = 'crm.lead'",
      "fields": [
        { "source": "id", "target": "source_record_id", "transform": "to_string" },
        { "source": "summary", "target": "summary", "transform": "direct" },
        { "source": "activity_type_id", "target": "activity_type", "transform": "extract_name" },
        { "source": "note", "target": "note", "transform": "strip_html" },
        { "source": "date_deadline", "target": "date_deadline", "transform": "direct" },
        { "source": "res_id", "target": "opportunity_id", "transform": "to_string" },
        { "source": "user_id", "target": "user_id", "transform": "extract_id" },
        { "source": "state", "target": "state", "transform": "direct" },
        { "source": "create_date", "target": "created_at", "transform": "direct" },
        { "source": "write_date", "target": "updated_at", "transform": "direct" }
      ]

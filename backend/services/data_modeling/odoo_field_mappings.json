        { "source": "techbuyer", "target": "technical_buyer_name", "transform": "extract_name" },
        { "source": "commbuyer", "target": "commercial_buyer_id", "transform": "extract_id" },
        { "source": "commbuyer", "target": "commercial_buyer_name", "transform": "extract_name" },
        { "source": "x_studio_is_a_technical_buyer", "target": "is_tech_buyer_coach", "transform": "direct" },
        { "source": "x_studio_is_a_commercial_buyer", "target": "is_comm_buyer_coach", "transform": "direct" },
        
        { "source": "x_studio_is_it_a_tender", "target": "is_tender", "transform": "direct" },
        { "source": "x_studio_rfprfq_invited", "target": "rfp_invited", "transform": "direct" },
        { "source": "x_studio_assisted_in_rfp", "target": "assisted_in_rfp", "transform": "direct" },
        { "source": "x_studio_tender_purchase_end_date", "target": "tender_purchase_deadline", "transform": "direct" },
        { "source": "x_studio_query_submission_date", "target": "query_submission_deadline", "transform": "direct" },
        { "source": "x_studio_tender_submission_date", "target": "tender_submission_deadline", "transform": "direct" },
        { "source": "x_studio_is_bid_bond_needed", "target": "is_bid_bond_needed", "transform": "direct" },
        
        { "source": "x_studio_budget_status", "target": "budget_status", "transform": "direct" },
